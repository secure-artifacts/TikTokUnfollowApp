<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floating_root"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/overlay_bg"
    android:padding="12dp"
    android:elevation="8dp">

    <!-- Header Drag Bar -->
    <LinearLayout
        android:id="@+id/ll_drag_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="TikTok 取关助手 ⚙️"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iv_close_floating"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="关闭" />
    </LinearLayout>

    <!-- Task Status Bar -->
    <TextView
        android:id="@+id/tv_task_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="状态: 就绪 (请进入已关注列表)"
        android:textColor="@color/accent_amber"
        android:textSize="12sp"
        android:paddingBottom="6dp" />

    <!-- Current Mode & Parameter Indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tv_mode_info"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="模式: 滑动到最底部取关"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Action Buttons Row: 开始, 暂停, 停止 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3">

        <!-- 开始 (Start) Button -->
        <Button
            android:id="@+id/btn_float_start"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="开始"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:padding="0dp"
            android:backgroundTint="@color/accent_green"
            android:layout_marginEnd="4dp" />

        <!-- 暂停 (Pause) Button -->
        <Button
            android:id="@+id/btn_float_pause"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="暂停"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:padding="0dp"
            android:backgroundTint="@color/accent_amber"
            android:layout_marginEnd="4dp" />

        <!-- 停止 (Stop) Button -->
        <Button
            android:id="@+id/btn_float_stop"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="停止"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:padding="0dp"
            android:backgroundTint="@color/accent_red" />
    </LinearLayout>

</LinearLayout>
